{
  "$id": "https://schemas.ranex.dev/common/path-contract-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accountable_human_role": {
      "minLength": 1,
      "type": "string"
    },
    "allowed_dependency_targets": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "applicability": {
      "type": "string"
    },
    "content_status": {
      "enum": [
        "MANUAL",
        "GENERATED",
        "LEGACY",
        "MIXED"
      ]
    },
    "data_classification": {
      "enum": [
        "PUBLIC",
        "INHERITS_SUBJECT_CLASSIFICATION"
      ]
    },
    "data_ownership_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "definition_status": {
      "const": "DEFINED"
    },
    "dependency_direction": {
      "minLength": 1,
      "type": "string"
    },
    "exception_metadata": {
      "additionalProperties": false,
      "properties": {
        "allowed_classes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "current_exception_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "allowed_classes",
        "current_exception_ids"
      ],
      "type": "object"
    },
    "governance_owner_context": {
      "minLength": 1,
      "type": "string"
    },
    "owner_context": {
      "minLength": 1,
      "type": "string"
    },
    "path_id": {
      "minLength": 1,
      "type": "string"
    },
    "path_pattern": {
      "minLength": 1,
      "type": "string"
    },
    "required_exception_class": {
      "type": "string"
    },
    "required_reviewer_role": {
      "minLength": 1,
      "type": "string"
    },
    "responsibility_class": {
      "minLength": 1,
      "type": "string"
    },
    "runtime_validation_status": {
      "const": "NOT_ASSESSED"
    },
    "semantic_owner_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "semantic_owner_kind": {
      "enum": [
        "EXACT_CONTEXT",
        "PARAMETERIZED_CONTEXT",
        "PARAMETERIZED_TEST_SUBJECT_OWNER",
        "FIXED_CROSS_CONTEXT_OWNER"
      ]
    },
    "semantic_owner_resolution": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "tdd_rule_ids": {
      "items": {
        "pattern": "^TDD-[A-Z0-9-]+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "topology_rule_ids": {
      "items": {
        "pattern": "^ORG-[A-Z0-9-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "path_id",
    "owner_context",
    "governance_owner_context",
    "semantic_owner_kind",
    "semantic_owner_context",
    "semantic_owner_resolution",
    "accountable_human_role",
    "required_reviewer_role",
    "path_pattern",
    "responsibility_class",
    "applicability",
    "allowed_dependency_targets",
    "dependency_direction",
    "data_ownership_refs",
    "data_classification",
    "content_status",
    "topology_rule_ids",
    "tdd_rule_ids",
    "exception_metadata",
    "definition_status",
    "runtime_validation_status",
    "source"
  ],
  "title": "Ranex governed path contract",
  "type": "object"
}

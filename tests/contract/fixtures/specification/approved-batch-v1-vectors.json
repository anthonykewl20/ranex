043b6e8e7b5872d0e574df44a7fa790d3befd34c67eba9","base_digest":"sha256:8da54cc69dc14c368720abbeb98d2c6b52de166de5117f4d809b8a4c521507ad","capability_request":{"actions":["execute","read"],"argv":["-c","import json,re,socket,subprocess,time\nfrom pathlib import Path\nw=Path.cwd().resolve()\ntry:\n attempt_name=w.name\n task_id=w.parent.name\n children=w.parent.parent\n flow_id=children.parent.name\n if children.name!='children' or re.fullmatch(r'SLICE-036-child-[A-Z]',task_id) is None or re.fullmatch(r'attempt-[0-6]',attempt_name) is None:\n  raise ValueError('worktree-geometry')\n attempt=int(attempt_name.removeprefix('attempt-'))\n input_path=Path('governance/qualification/inputs')/(task_id+'.json')\n p=json.loads(input_path.read_text(encoding='utf-8'))\n if set(p)!={'attempts','loopback_ports','task_id','version'} or p['version']!='slice036-child-input-v1' or p['task_id']!=task_id:\n  raise ValueError('input-identity')\n current=p['attempts'].get(str(attempt))\n if not isinstance(current,dict) or set(current)!={'delays_ms','mode'} or flow_id not in current['delays_ms']:\n  raise ValueError('attempt-or-flow')\n delay_ms=current['delays_ms'][flow_id]\n if type(delay_ms) is not int or delay_ms<0 or current['mode'] not in {'normal','network-control','survivor','oracle-mismatch'}:\n  raise ValueError('input-shape')\n ports=p['loopback_ports']\n if ports!=list(range(46120,46136)):\n  raise ValueError('loopback-ports')\nexcept (OSError,ValueError,TypeError,KeyError,json.JSONDecodeError):\n print(json.dumps({'code':'E-BATCH-INPUT-MISMATCH','event':'batch.child.refused'},sort_keys=True,separators=(',',':')))\n raise SystemExit(92)\ntime.sleep(delay_ms/1000)\nescaped=False\nfor port in ports:\n try:\n  s=socket.create_connection(('127.0.0.1',port),timeout=.02);s.close();escaped=True;break\n except OSError: pass\npid=None\nif current['mode']=='survivor':\n pid=subprocess.Popen(['/bin/sh','-c','exec -a ranex-slice036-survivor-control-v1 /bin/sleep 30'],start_new_session=True).pid\n time.sleep(.5)\nvalue='oracle-mismatch' if current['mode']=='oracle-mismatch' else 'ok'\nprint(json.dumps({'flow_id':flow_id,'network':'escaped' if escaped else 'denied','pid':pid,'task_id':task_id,'value':value},sort_keys=True,separators=(',',':')))\nraise SystemExit(91 if escaped or current['mode']=='network-control' else 0)"],"commit":{"allow":false},"cwd":".","environment":{"allow":["LC_ALL","TZ"]},"executable":"python","network":{"allow":false,"hosts":[]},"roots":["README.md","governance/qualification/inputs/SLICE-036-child-A.json","governance/qualification/inputs/SLICE-036-child-B.json","governance/qualification/inputs/SLICE-036-child-C.json","governance/qualification/inputs/SLICE-036-child-D.json","src/ranex/foundation/canonical.py","src/ranex/foundation/signing.py","src/ranex/foundation/specification_abc.py"],"secret":{"allow":false,"names":[]},"subagent":{"allow":false,"max_children":0}},"domain":"kernel","journal_predecessor":null,"key":"ed25519:A6EHv/POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg=","nonce":"slice036-approved-batch-v10","principal":"owner","profile_digests":{"base":"sha256:8da54cc69dc14c368720abbeb98d2c6b52de166de5117f4d809b8a4c521507ad","generator":"sha256:f758cc9c30d59abd55ebf5728ffc4929fbd706f1ed6c4706e9bd98e56569fe03","harness":"sha256:f6e5fb06b5ae84855a8a0e8a5573f45ba92c50c9caf7b0e3eae95bff8fad8e0f","policy":"sha256:de2d21ea1093ed91e08d0260733f9b82fd92f3b605bb61247355730b77a65e72"},"revision":8,"role":"approver","subject_digest":"sha256:8da54cc69dc14c368720abbeb98d2c6b52de166de5117f4d809b8a4c521507ad","task":"SLICE-036","time_window":{"not_after":100,"not_before":0},"version":"approval-payload-v1"},"key_id":"ed25519:A6EHv/POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg=","signature":"ed25519:kyMqLasvaFjLqVKQapE26bDYsTOZSbOvwVQrObVQiRKXEFsdG4MVDgcxZ9LPf42TfqHahCZiRy8CroYp+OWwDg=="},"version":"approved-batch-v1-vectors-10"}

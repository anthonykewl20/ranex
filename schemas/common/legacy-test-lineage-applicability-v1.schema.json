{
  "$id": "https://schemas.ranex.dev/common/legacy-test-lineage-applicability-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision_binding": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "const": "ADR-0021"
        },
        "digest": {
          "const": "sha256:1b6ca0051d3eb406b299f12b7d24a22b8d96990111bbca3fe922e6c17a5e45ee"
        },
        "path": {
          "const": "docs/architecture/decisions/ADR-0021-limit-adr-0010-to-inherited-lineage.md"

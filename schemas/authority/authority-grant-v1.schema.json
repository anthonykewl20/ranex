{
  "$id": "https://schemas.ranex.dev/authority/authority-grant-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_type": {
      "type": "string"
    },
    "artifact_type": {
      "const": "consumable_authority_grant"
    },
    "canonical_argument_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "conditions": {
      "items": {},
      "type": "array"
    },
    "consumed_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "consumed_by_transition_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expected_run_aggregate_version": {
      "minimum": 0,
      "type": "integer"
    },
    "expires_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "gate_evaluation_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gate_evaluation_id": {
      "type": "string"
    },
    "grant_id": {
      "type": "string"
    },
    "human_decision_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "human_decision_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "revoked_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1"
    },
    "scope": {
      "items": {},
      "type": "array"
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "grant_id",
    "status",
    "human_decision_id",
    "human_decision_digest",
    "gate_evaluation_id",
    "gate_evaluation_digest",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "action_type",
    "canonical_argument_digest",
    "scope",
    "conditions",
    "issued_at",
    "expires_at",
    "revoked_at",
    "consumed_at",
    "consumed_by_transition_id",
    "expected_run_aggregate_version",
    "digest"
  ],
  "title": "consumable_authority_grant",
  "type": "object",
  "x-ranex-canonical-producer": "governed_execution",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/AUTHORITY_GRANT.yaml"
}

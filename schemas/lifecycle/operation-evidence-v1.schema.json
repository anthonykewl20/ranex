{
  "$id": "https://schemas.ranex.dev/lifecycle/operation-evidence-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "operation_evidence"
    },
    "backup_restore_evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "incident_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limitations": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "observation_window": {
      "additionalProperties": false,
      "properties": {
        "ended_at": {
          "type": "string",
          "x-ranex-runtime-format": "date-time"
        },
        "started_at": {
          "type": "string",
          "x-ranex-runtime-format": "date-time"
        }
      },
      "required": [
        "started_at",
        "ended_at"
      ],
      "type": "object"
    },
    "operation_evidence_id": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "reconciliation_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "release_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "security_evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "service_id": {
      "type": "string"
    },
    "service_owner_decision_ref": {
      "type": "string"
    },
    "sli_slo_evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": "string"
    },
    "support_evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "work_item_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "operation_evidence_id",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "release_id",
    "service_id",
    "work_item_id",
    "observation_window",
    "sli_slo_evidence_refs",
    "support_evidence_refs",
    "security_evidence_refs",
    "backup_restore_evidence_refs",
    "incident_refs",
    "reconciliation_refs",
    "service_owner_decision_ref",
    "outcome",
    "limitations",
    "digest"
  ],
  "title": "operation_evidence",
  "type": "object",
  "x-ranex-canonical-producer": "operations",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/OPERATION_EVIDENCE.yaml"
}

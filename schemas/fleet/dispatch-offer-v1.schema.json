{
  "$id": "https://schemas.ranex.dev/fleet/dispatch-offer-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate_version": {
      "minimum": 0,
      "type": "integer"
    },
    "artifact_type": {
      "const": "dispatch_offer"
    },
    "assignment_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assignment_id": {
      "type": "string"
    },
    "claimed_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "claimed_by_principal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eligibility_policy_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eligibility_policy_id": {
      "type": "string"
    },
    "eligible_principal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "issued_by_service_id": {
      "type": "string"
    },
    "offer_id": {
      "type": "string"
    },
    "required_harness_qualification_scope": {
      "type": "string"
    },
    "required_role_id": {
      "type": "string"
    },
    "required_route_qualification_scope": {
      "type": "string"
    },
    "revocation_reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "revoked_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1"
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "offer_id",
    "status",
    "aggregate_version",
    "assignment_id",
    "assignment_digest",
    "eligible_principal_id",
    "eligibility_policy_id",
    "eligibility_policy_digest",
    "required_role_id",
    "required_route_qualification_scope",
    "required_harness_qualification_scope",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "issued_by_service_id",
    "issued_at",
    "expires_at",
    "claimed_at",
    "claimed_by_principal_id",
    "revoked_at",
    "revocation_reason_code",
    "digest"
  ],
  "title": "dispatch_offer",
  "type": "object",
  "x-ranex-canonical-producer": "agent_collaboration",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/DISPATCH_OFFER.yaml"
}

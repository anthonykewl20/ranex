{
  "$id": "https://schemas.ranex.dev/events/work_management/work-item-classified-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_ids": {
      "items": {
        "maxLength": 255,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
        "type": "string",
        "x-ranex-id-type": "Capability",
        "x-ranex-registered-opaque-id": true
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
      "x-ranex-bytewise-sorted": true
    },
    "classification_decision_ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
          "type": "string",
          "x-ranex-id-type": "HumanDecisionRecord",
          "x-ranex-registered-opaque-id": true
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object",
      "x-ranex-ref-type": "HumanDecisionRecord"
    },
    "context_ids": {
      "items": {
        "maxLength": 255,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
        "type": "string",
        "x-ranex-id-type": "Context",
        "x-ranex-registered-opaque-id": true
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
      "x-ranex-bytewise-sorted": true
    },
    "work_class": {
      "enum": [
        "PRODUCT",
        "DEFECT",
        "RELIABILITY",
        "SECURITY_PRIVACY",
        "ARCHITECTURE_PLATFORM",
        "COMPLIANCE_PROVENANCE",
        "UPSTREAM_SYNC",
        "MAINTENANCE",
        "RETIREMENT",
        "INCIDENT_RESPONSE"
      ],
      "type": "string",
      "x-ranex-enum-binding": "states.json#WorkClass@1.0.0"
    },
    "work_item_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
      "type": "string",
      "x-ranex-id-type": "WorkItem",
      "x-ranex-registered-opaque-id": true
    }
  },
  "required": [
    "work_item_id",
    "work_class",
    "capability_ids",
    "context_ids",
    "classification_decision_ref"
  ],
  "title": "WorkItemClassified event payload v1",
  "type": "object",
  "x-ranex-event-id": "EVENT-WORKITEMCLASSIFIED",
  "x-ranex-event-name": "WorkItemClassified",
  "x-ranex-event-version": 1,
  "x-ranex-payload-schema-ref": "ranex:event-payload:WorkItemClassified:v1",
  "x-ranex-source": "docs/architecture/HERMES_GROUND_ZERO_FULL_SYSTEM_ARCHITECTURE.md#172-exact-initial-event-payload-catalog",
  "x-ranex-state-binding": {
    "binding_kind": "REFERENCE_ONLY",
    "event_name": "WorkItemClassified",
    "referenced_axis_ids": [
      "WorkClass"
    ]
  },
  "x-ranex-state-binding-digest": "sha256:8cb48989112d070db4146cabfecbcc4b1b8d34144cedce8d688ccadd38e990c3"
}

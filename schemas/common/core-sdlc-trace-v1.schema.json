        "release": {
          "type": [
            "string",
            "null"
          ]
        },
        "security_data": {
          "type": [
            "string",
            "null"
          ]
        },
        "service": {
          "type": [
            "string",
            "null"
          ]
        },
        "supplier": {
          "type": [
            "string",
            "null"
          ]
        },
        "technical": {
          "type": [
            "string",
            "null"
          ]
        },
        "vv": {
          "type": [
            "string",
            "null"
          ]
        }

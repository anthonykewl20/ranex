{
  "$id": "https://ranex.dev/governance/schemas/delegated-provider/ranex-delegated-provider-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "protocol": {
    "bind": "127.0.0.1:ephemeral",
    "bootstrap": {
      "allowedToolNames": "sorted unique UTF-8 byte order; maxItems=32; each matches ^[A-Za-z0-9_-]{1,64}$",
      "canonical": "strict duplicate-key rejection; bounded object; UTF-8 JSON",
      "endpoint": {
        "host": "127.0.0.1",
        "port": "OS-assigned ephemeral port, 1..65535",
        "scheme": "http"
      },
      "handshakeDeadline": "5 seconds; absent, malformed, or unsupported handshake terminates harness and refuses upstream with invalid_protocol/unsupported_version",
      "modelPattern": "^[A-Za-z0-9._:/-]{1,256}$",
      "protocol": "ranex-delegated-provider",
      "required": [
        "protocol",
        "version",
        "taskId",
        "endpoint",
        "capability",
        "provider",
        "model",
        "allowedToolNames",
        "expiresAt",
        "limits"
      ],
      "version": 1
    },
    "chat": "POST /v1/chat/completions",
    "chatAccounting": {
      "decrement": "after local validation succeeds, atomically reserve one slot immediately before upstream I/O; a reserved attempt consumes exactly one forever",
      "emission": "pre-reservation failure consumes zero and emits none; every post-reservation terminal consumes exactly one and emits exactly one delegation provider-attempt stage",
      "replay": "replayed requestId is rejected before reservation and consumes no request",
      "retries": "none",
      "remainingRequests": "broker session state returned by handshake only; never carried in relayed SSE"
    },
    "chatReplayKey": [
      "session",
      "requestId"
    ],
    "chatTimeout": "min(120s, remaining session TTL)",
    "distinctRequestIds": "at most 8 accepted reservations per session; every accepted requestId is unique within that session",
    "fixture": {
      "harness": "vendor exact JSON fixture",
      "path": "governance/schemas/delegated-provider/ranex-delegated-provider-v1.json",
      "sha256": "pinned in tests/contract/test_delegated_provider_protocol.py EXPECTED_SHA256"
    },
    "grant": {
      "chat": "provider and model must equal grant; chat tool names must be a subset",
      "duplicateIncomingToolNames": "invalid_request",
      "generated": "once from task/run inputs by kernel",
      "harnessOverride": "forbidden",
      "model": "exact case-sensitive value matching bootstrap model and ^[A-Za-z0-9._:/-]{1,256}$",
      "provider": "openrouter",
      "toolNames": "exact case-sensitive values matching ^[A-Za-z0-9_-]{1,64}$, maxItems=32, sorted unique by UTF-8 bytes"
    },
    "handshake": "POST /v1/handshake",
    "handshakeAccounting": "uncounted",
    "handshakeReplayKey": [
      "capability"
    ],
    "handshakeUse": "single-use-per-capability-session",
    "httpSse": {
      "countBefore": "decode, parse, or write; includes delimiters, comments, BOM, DONE, and offending bytes",
      "done": "only a dispatched event whose assembled data is exactly [DONE]; terminal event relayed unchanged",
      "eof": "EOF before DONE, invalid UTF-8, malformed framing, line/event/body limit => upstream_protocol",
      "maxBodyBytes": 16777216,
      "maxEventDataBytes": 1048576,
      "maxRawLineBytes": 65536,
      "post200Failure": "close downstream without synthetic SSE; broker audit is authoritative",
      "relay": "preserve each complete valid event original bytes exactly; no JSON rewriting",
      "status": 200,
      "stream": true,
      "timeouts": {
        "connectTlsSeconds": 10,
        "firstByteSeconds": 30,
        "interReadIdleSeconds": 30,
        "total": "min(120s, remaining TTL)"
      },
      "upstreamExact": "https://openrouter.ai/api/v1/chat/completions"
    },
    "logging": {
      "authoritativeEmitter": "kernel broker",
      "broker": "no independent logs",
      "events": [
        "cli.task.delegate.start",
        "cli.task.delegate.end",
        "stage"
      ],
      "fields": [
        "event",
        "sid",
        "time",
        "level",
        "module",
        "stage",
        "subject_digest",
        "duration_us",
        "hierarchy",
        "child_id",
        "code"
      ],
      "format": "JSONL",
      "harness": "must not emit delegation audit events",
      "providerAttempt": {
        "code": {
          "argumentSet": [
            "success",
            "response_too_large",
            "upstream_timeout",
            "upstream_http",
            "redirect_refused",
            "upstream_protocol",
            "server_shutdown",
            "internal"
          ],
          "form": "delegation_provider_attempt:<argument>"
        },
        "event": "stage",
        "fields": {
          "nonNull": [
            "event",
            "sid",
            "time",
            "level",
            "module",
            "stage",
            "duration_us",
            "code"
          ],
          "null": [
            "subject_digest",
            "hierarchy",
            "child_id"
          ]
        },
        "module": "cli",
        "stage": "cli.task.delegate.provider_attempt",
        "emitter": "kernel broker exactly once per reserved attempt; harness never emits"
      },
      "schemaEvolution": "issue #43 owns the additive schema.py registry entry and its schema contract tests; this ADR and fixture define the valid event instance",
      "secrets": "no session/auth headers/raw prompts",
      "time": "UTC"
    },
    "maxBootstrapBytes": 65536,
    "maxConcurrency": 1,
    "maxRequestBytes": 4194304,
    "maxRequests": 8,
    "maxRequestsScope": "chat only; provider attempts",
    "maxResponseBytes": 16777216,
    "name": "ranex-delegated-provider",
    "persistence": "none",
    "policy": {
      "chatModel": "must equal handshake model",
      "chatProvider": "if omitted, use the authenticated session provider; if present, it must equal the session provider",
      "chatTools": "function.name set must be subset of handshake tools",
      "default": "deny",
      "handshakeModel": "binds session",
      "handshakeTools": "allowed function names",
      "hostedProviderTools": "refuse",
      "modelSource": "kernel task grant"
    },
    "preStreamHttpStatus": {
      "invalid_protocol": 400,
      "unsupported_version": 426,
      "unauthorized": 401,
      "handshake_required": 401,
      "session_mismatch": 401,
      "replay": 409,
      "expired": 410,
      "model_not_allowed": 403,
      "provider_not_allowed": 403,
      "invalid_request": 400,
      "tool_not_allowed": 403,
      "request_too_large": 413,
      "concurrency_limit": 429,
      "request_limit": 429,
      "preStream": "return bounded generic JSON {error,message}; never leak upstream body",
      "post200": "after downstream 200 headers commit, close downstream without synthetic SSE; no pre-stream status is returned and the stage audit is authoritative"
    },
    "preDownstreamHttpStatus": {
      "response_too_large": 502
    },
    "redirects": "refuse",
    "requestBytes": "raw HTTP request body",
    "requestId": {
      "encoding": "base64url",
      "finalCharacters": "AQgw",
      "length": 22,
      "randomBytes": 16
    },
    "responseBytes": "cumulative SSE bytes",
    "retry": "none",
    "schemaValidation": "handshake/chat provider/model/tools schemas are structurally permissive on purpose so authoritative validation+policy returns stable provider_not_allowed/model_not_allowed/tool_not_allowed; bootstrap+grant carry stricter immutable shapes",
    "stream": "text/event-stream",
    "timeoutScope": "whole request/stream",
    "timeoutSeconds": 120,
    "transport": {
      "bootstrap": "one bounded canonical JSON object on an O_CLOEXEC pipe at exact FD 3",
      "brokerTransport": "direct TLS through a verified HTTP stack",
      "capability": "random capability in bootstrap, then authenticated handshake",
      "childEnvironment": "explicit allowlist; excludes raw key and credential-pattern variables",
      "fd3CloseAll": "kernel reads and closes its ingress FD 3; after that it creates a distinct child pipe whose read end is mapped to harness FD 3 and whose bytes are capability bootstrap only; the descriptor number is reused across process boundaries, never the bytes",
      "fd3SelfAlias": "source read fd == 3 is repaired before posix_spawn by CLOEXEC duplication to fd >=4; no self-DUP2 close-order ambiguity",
      "harnessEntry": "reads bounded capability bootstrap from child FD 3 at earliest entrypoint, validates, closes FD 3 immediately after the bounded read and before command/session/model/children",
      "harnessStorage": "bounded in-memory only",
      "httpStack": "Python stdlib http.client for HTTP transport and standard TLS certificate/hostname verification; no custom HTTP or TLS replacement",
      "legacyRefusal": "any harness absent/malformed/unsupported FD3 bootstrap, non-FD3 bootstrap, or handshake not authenticated within 5 seconds is terminated/refused as invalid_protocol or unsupported_version before upstream; no raw-key fallback or legacy CLI",
      "rawKeyIngress": "kernel receives the raw provider key only through an inherited FD/pipe owned by the kernel process",
      "rawKeyProhibited": [
        "harness process",
        "argv",
        "bootstrap",
        "files",
        "logs",
        "request bodies"
      ],
      "rawKeyResidency": "kernel/broker memory only",
      "redirects": "refuse",
      "spawn": "kernel reads and closes its inherited raw-key ingress FD; it then creates a distinct O_CLOEXEC child pipe, maps only the capability bootstrap read end to harness FD 3, closes the source/original and unrelated descriptors using the verified close-all strategy, then setsid",
      "sseValidator": "in-repository bounded frame validator implementing exactly the frozen WHATWG-compatible grammar; no custom TLS/HTTP replacement"
    },
    "ttlAccounting": "session-wall-clock",
    "ttlSeconds": 300,
    "upstream": "https://openrouter.ai/api/v1/chat/completions",
    "validation": {
      "failBeforeUpstream": true,
      "fieldErrors": {
        "capability": {
          "comparison": "constant-time",
          "error": "unauthorized"
        },
        "model": "model_not_allowed",
        "provider": "provider_not_allowed",
        "requestId": {
          "replay": "replay",
          "structural": "invalid_request",
          "terminalCharacters": "must be one of AQgw; any other final character is invalid_request"
        },
        "session": {
          "activeUnderDifferentValidCapability": "session_mismatch",
          "comparison": "constant-time capability comparison",
          "oracle": "stable error code and generic message only; disclose no session existence or capability details",
          "unknownOrUnauthenticated": "unauthorized"
        },
        "structuralFields": [
          "protocol",
          "messages",
          "stream",
          "requestId"
        ],
        "tools": "tool_not_allowed"
      },
      "precedence": [
        "request_too_large",
        "invalid_protocol",
        "unsupported_version",
        "unauthorized",
        "handshake_required",
        "session_mismatch",
        "replay",
        "expired",
        "provider_not_allowed",
        "model_not_allowed",
        "tool_not_allowed",
        "invalid_request",
        "concurrency_limit",
        "request_limit",
        "upstream"
      ],
      "reservationState": {
        "preReservation": {
          "consumes": 0,
          "emits": 0,
          "errors": [
            "invalid_protocol",
            "unsupported_version",
            "unauthorized",
            "handshake_required",
            "session_mismatch",
            "replay",
            "expired",
            "model_not_allowed",
            "provider_not_allowed",
            "invalid_request",
            "tool_not_allowed",
            "request_too_large",
            "concurrency_limit",
            "request_limit"
          ]
        },
        "postReservation": {
          "consumes": 1,
          "emits": 1,
          "outcomes": [
            "success",
            "response_too_large",
            "upstream_timeout",
            "upstream_http",
            "redirect_refused",
            "upstream_protocol",
            "server_shutdown",
            "internal"
          ]
        }
      }
    },
    "version": 1
  },
  "schemas": {

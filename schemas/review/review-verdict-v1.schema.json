{
  "$id": "https://schemas.ranex.dev/review/review-verdict-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "review_verdict"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "items": {},
      "type": "array"
    },
    "independence_evaluation_id": {
      "type": "string"
    },
    "limitations": {
      "items": {},
      "type": "array"
    },
    "observation_ids": {
      "items": {},
      "type": "array"
    },
    "open_finding_refs": {
      "items": {},
      "type": "array"
    },
    "produced_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "producer_service_id": {
      "type": "string"
    },
    "reconciliation_refs": {
      "items": {},
      "type": "array"
    },
    "resolved_finding_refs": {
      "items": {},
      "type": "array"
    },
    "review_request_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "type": "string"
    },
    "verdict_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "verdict_id",
    "review_request_id",
    "observation_ids",
    "independence_evaluation_id",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "verdict",
    "open_finding_refs",
    "resolved_finding_refs",
    "reconciliation_refs",
    "evidence_refs",
    "limitations",
    "producer_service_id",
    "produced_at",
    "digest"
  ],
  "title": "review_verdict",
  "type": "object",
  "x-ranex-canonical-producer": "analytical_review",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/REVIEW_VERDICT.yaml"
}

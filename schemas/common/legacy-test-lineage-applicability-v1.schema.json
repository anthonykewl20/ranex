          "const": "NOT_ASSESSED"
        },
        "status": {
          "const": "ACCEPTED_PAPER_DECISION"
        }
      },
      "required": [
        "decision_id",
        "path",
        "digest",
        "status",
        "runtime_enactment_status"
      ],
      "type": "object"
    },
    "exact_noninherited_lineage": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_authorization_ref": {
          "const": "architecture/records/bootstrap-authorizations/BOOTSTRAP-AUTH-001.md"
        },
        "bootstrap_authorization_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "boundary_ancestry_test_commit_count": {
          "const": 0
        },
        "boundary_baseline_path_intersection_count": {
          "const": 0
        },
        "boundary_commit_sha1": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "boundary_committed_test_path_count": {
          "const": 0
        },
        "root_commit_sha1": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "walking_skeleton_definition_ref": {
          "const": "docs/architecture/reviews/2026-07-31-walking-skeleton-definition.md"
        },
        "walking_skeleton_definition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "root_commit_sha1",
        "boundary_commit_sha1",
        "boundary_committed_test_path_count",
        "boundary_ancestry_test_commit_count",
        "boundary_baseline_path_intersection_count",
        "bootstrap_authorization_ref",
        "bootstrap_authorization_sha256",
        "walking_skeleton_definition_ref",
        "walking_skeleton_definition_sha256"

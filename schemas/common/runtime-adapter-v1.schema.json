{
  "$id": "https://schemas.ranex.dev/common/runtime-adapter-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_fallback": {
      "type": "string"
    },
    "allowed_tools_semantics": {
      "type": "string"
    },
    "ambient_configuration": {
      "type": "string"
    },
    "auth_policy": {
      "additionalProperties": false,
      "properties": {
        "credential_file_extraction": {
          "type": "string"
        },
        "environment_precedence": {
          "type": "string"
        },
        "local_individual_subscription": {
          "type": "string"
        },
        "product_api_or_cloud": {
          "type": "string"
        }
      },
      "required": [
        "local_individual_subscription",
        "product_api_or_cloud",
        "environment_precedence",
        "credential_file_extraction"
      ],
      "type": "object"
    },
    "auxiliary_model_calls": {
      "type": "string"
    },
    "cancellation": {
      "type": "string"
    },
    "catalog_id": {
      "type": "string"
    },
    "catalog_status": {
      "type": "string"
    },
    "catalog_version": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event_correlation": {
      "type": "string"
    },
    "exact_full_model_id_required": {
      "type": "boolean"
    },
    "exact_model_required": {
      "type": "boolean"
    },
    "forbidden_runtime_tool_names": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "leaf_worker_only": {
      "type": "boolean"
    },
    "lifecycle": {
      "type": "string"
    },
    "model_fallback": {
      "type": "string"
    },
    "nested_parent_tool_use_id": {
      "type": "string"
    },
    "official_runtime": {
      "type": "string"
    },
    "official_source": {
      "type": "string"
    },
    "preconnect": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    },
    "provider_fallback": {
      "type": "string"
    },
    "provider_family": {
      "type": "string"
    },
    "resume": {
      "type": "string"
    },
    "runtime_adapter_id": {
      "type": "string"
    },
    "runtime_validation_status": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "startup_attestation": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "structured_events": {
      "type": "boolean"
    },
    "tool_surface_enforcement": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "version": {
      "type": "string"
    },
    "warm_reuse": {
      "additionalProperties": false,
      "properties": {
        "cross_assignment": {
          "type": "boolean"
        },
        "cross_project": {
          "type": "boolean"
        },
        "key_fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "scope",
        "cross_assignment",
        "cross_project",
        "key_fields"
      ],
      "type": "object"
    },
    "worker_delegation": {
      "type": "string"
    },
    "worker_spawn": {
      "type": "string"
    }
  },
  "required": [
    "runtime_adapter_id",
    "version",
    "lifecycle",
    "provider_family",
    "official_runtime",
    "protocol",
    "official_source",
    "exact_model_required",
    "exact_full_model_id_required",
    "leaf_worker_only",
    "worker_spawn",
    "worker_delegation",
    "adapter_fallback",
    "provider_fallback",
    "model_fallback",
    "auxiliary_model_calls",
    "ambient_configuration",
    "tool_surface_enforcement",
    "allowed_tools_semantics",
    "startup_attestation",
    "structured_events",
    "event_correlation",
    "nested_parent_tool_use_id",
    "cancellation",
    "resume",
    "preconnect",
    "auth_policy",
    "warm_reuse",
    "catalog_id",
    "catalog_version",
    "catalog_status",
    "source",
    "source_digest",
    "runtime_validation_status",
    "digest"
  ],
  "title": "Ranex official leaf-worker runtime adapter",
  "type": "object",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-source-registry": "architecture/contracts/runtime-adapters.json"
}

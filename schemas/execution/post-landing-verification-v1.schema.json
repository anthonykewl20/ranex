{
  "$id": "https://schemas.ranex.dev/execution/post-landing-verification-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "post_landing_verification"
    },
    "checker_result_refs": {
      "items": {},
      "type": "array"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "landed_commit": {
      "type": "string"
    },
    "landing_id": {
      "type": "string"
    },
    "limitations": {
      "items": {},
      "type": "array"
    },
    "orphan_authority_checks": {
      "items": {},
      "type": "array"
    },
    "outcome": {
      "type": "string"
    },
    "projection_reconciliation_refs": {
      "items": {},
      "type": "array"
    },
    "release_state_checks": {
      "items": {},
      "type": "array"
    },
    "rollback_point_ref": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": "string"
    },
    "verification_id": {
      "type": "string"
    },
    "worktree_cleanup_ref": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "verification_id",
    "landing_id",
    "landed_commit",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "checker_result_refs",
    "projection_reconciliation_refs",
    "orphan_authority_checks",
    "release_state_checks",
    "rollback_point_ref",
    "worktree_cleanup_ref",
    "outcome",
    "limitations",
    "created_at",
    "digest"
  ],
  "title": "post_landing_verification",
  "type": "object",
  "x-ranex-canonical-producer": "assurance",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/POST_LANDING_VERIFICATION.yaml"
}

{
  "$id": "https://schemas.ranex.dev/common/evidence-ref.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "evidence_ref",
    "evidence_digest"
  ],
  "type": "object"
}

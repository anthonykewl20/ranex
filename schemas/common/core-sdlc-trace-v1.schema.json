  "type": "object",
  "x-ranex-canonical-producer": "configuration_management",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/CORE_SDLC_TRACE.yaml"

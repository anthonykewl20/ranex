              "WorkItemStatus",
              "RunStatus",
              "AssignmentStatus",
              "DispatchOfferStatus",
              "LeaseStatus",
              "MailboxDeliveryStatus",
              "ReservationStatus",
              "IntakeStatus",
              "PacketStatus",
              "FleetExperimentStatus",
              "CapabilityAssessmentStatus",
              "ActivityStatus",
              "PermitStatus",
              "HumanDecisionRecordStatus",
              "AuthorityGrantStatus",
              "EffectStatus",
              "ReconciliationStatus",
              "IncidentStatus",
              "ReleaseStatus",
              "CapabilityStatus",
              "ModuleStatus",
              "RouteStatus",
              "ExtensionStatus",
              "CompatibilityStatus",
              "InstructionStatus",
              "ArtifactStatus",
              "MigrationStatus",
              "SyncCandidateStatus",
              "UpdateStatus",
              "CutoverStatus"

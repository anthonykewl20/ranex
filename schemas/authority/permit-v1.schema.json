{
  "$id": "https://schemas.ranex.dev/authority/permit-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "type": "string"
        },
        "adapter_id": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "canonical_argument_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "destination": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        }
      },
      "required": [
        "action_type",
        "canonical_argument_digest",
        "destination",
        "adapter_id",
        "adapter_version",
        "idempotency_key"
      ],
      "type": "object"
    },
    "artifact_type": {
      "const": "permit"
    },
    "authority_grant_id": {
      "type": "string"
    },
    "authority_policy_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "consumed_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "decision_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "evidence_snapshot_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_snapshot_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "gate_evaluation_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gate_evaluation_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "issuer_principal_id": {
      "type": "string"
    },
    "nonce": {
      "type": "string"
    },
    "permit_id": {
      "type": "string"
    },
    "revoked_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1"
    },
    "scope": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "type": "string"
        },
        "artifact_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_commit": {
          "type": "string"
        },
        "candidate_commit": {
          "type": "string"
        },
        "capability_grant_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effect_id": {
          "type": "string"
        },
        "expected_run_aggregate_version": {
          "minimum": 0,
          "type": "integer"
        },
        "module_profile_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "module_profile_id": {
          "type": "string"
        },
        "packet_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "packet_id": {
          "type": "string"
        },
        "policy_activation_id": {
          "type": "string"
        },
        "policy_activation_manifest_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy_decision_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "project_id": {
          "type": "string"
        },
        "repository_id": {
          "type": "string"
        },
        "repository_uri_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "route_lock_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "schema_registry_version": {
          "type": "string"
        },
        "subject_schema": {
          "type": "string"
        },
        "work_item_id": {
          "type": "string"
        },
        "workflow_definition_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workflow_definition_id": {
          "type": "string"
        },
        "workflow_interpreter_version": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "subject_schema",
        "project_id",
        "work_item_id",
        "run_id",
        "activity_id",
        "effect_id",
        "workspace_id",
        "repository_id",
        "repository_uri_digest",
        "base_commit",
        "candidate_commit",
        "artifact_digest",
        "packet_id",
        "packet_digest",
        "workflow_definition_id",
        "workflow_definition_digest",
        "workflow_interpreter_version",
        "policy_activation_id",
        "policy_activation_manifest_digest",
        "policy_decision_digest",
        "module_profile_id",
        "module_profile_digest",
        "capability_grant_digest",
        "route_lock_id",
        "schema_registry_version",
        "expected_run_aggregate_version"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "permit_id",
    "status",
    "core_sdlc_trace_ref",
    "issuer_principal_id",
    "authority_policy_digest",
    "subject",
    "action",
    "scope",
    "nonce",
    "issued_at",
    "expires_at",
    "consumed_at",
    "revoked_at",
    "decision_refs",
    "authority_grant_id",
    "gate_evaluation_id",
    "gate_evaluation_digest",
    "evidence_snapshot_id",
    "evidence_snapshot_digest",
    "evidence_refs",
    "digest"
  ],
  "title": "permit",
  "type": "object",
  "x-ranex-canonical-producer": "governed_execution",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/PERMIT.yaml"
}

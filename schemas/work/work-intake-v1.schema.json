{
  "$id": "https://schemas.ranex.dev/work/work-intake-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "acceptance_criterion_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "affected_capabilities": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "artifact_type": {
      "const": "work_intake"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "data_classifications": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "decision_owner_principal_id": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "external_effects": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "full_map_zones": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "initial_risk_signals": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "intake_id": {
      "type": "string"
    },
    "invalidation_dependency_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "known_constraints": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "non_goals": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "objective": {
      "type": "string"
    },
    "outcome_measure_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requester_principal_id": {
      "type": "string"
    },
    "required_human_decisions": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "requirement_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reversibility": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "scope": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "status": {
      "type": "string"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "base_revision": {
          "type": "string"
        },
        "design_baseline_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "string",
          "x-ranex-runtime-format": "date-time"
        },
        "project_id": {
          "type": "string"
        },
        "repository_id": {
          "type": "string"
        },
        "repository_uri_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "requirements_baseline_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "signal_evidence_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_schema": {
          "type": "string"
        },
        "work_baseline_manifest_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "work_item_id": {
          "type": "string"
        }
      },
      "required": [
        "subject_schema",
        "project_id",
        "work_item_id",
        "repository_id",
        "repository_uri_digest",
        "base_revision",
        "work_baseline_manifest_digest",
        "signal_evidence_digest",
        "requirements_baseline_digest",
        "design_baseline_digest",
        "observed_at"
      ],
      "type": "object"
    },
    "user_outcome": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "intake_id",
    "status",
    "requester_principal_id",
    "decision_owner_principal_id",
    "subject",
    "objective",
    "user_outcome",
    "outcome_measure_ids",
    "requirement_ids",
    "acceptance_criterion_ids",
    "scope",
    "non_goals",
    "acceptance_criteria",
    "core_sdlc_trace_ref",
    "full_map_zones",
    "affected_capabilities",
    "external_effects",
    "data_classifications",
    "reversibility",
    "initial_risk_signals",
    "required_human_decisions",
    "known_constraints",
    "invalidation_dependency_ids",
    "digest"
  ],
  "title": "work_intake",
  "type": "object",
  "x-ranex-canonical-producer": "work_management",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/WORK_INTAKE.yaml"
}

{
  "$id": "https://schemas.ranex.dev/authority/human-decision-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "type": "string"
        },
        "adapter_id": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "canonical_argument_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "destination": {
          "type": "string"
        }
      },
      "required": [
        "action_type",
        "canonical_argument_digest",
        "destination",
        "adapter_id",
        "adapter_version"
      ],
      "type": "object"
    },
    "artifact_type": {
      "const": "human_decision"
    },
    "authentication_context_id": {
      "type": "string"
    },
    "conditions": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "core_sdlc_trace_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_id": {
      "type": "string"
    },
    "decision_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "expires_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "nonce": {
      "type": "string"
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "presentation_challenge_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "principal_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "revoked_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1"
    },
    "scope": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "status": {
      "type": "string"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "subject_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_manifest_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_ref": {
          "type": "string"
        },
        "subject_schema": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "subject_schema",
        "subject_ref",
        "subject_digest",
        "subject_manifest_digest"
      ],
      "type": "object"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "decision_id",
    "principal_id",
    "authentication_context_id",
    "presentation_challenge_digest",
    "status",
    "decision_kind",
    "outcome",
    "core_sdlc_trace_ref",
    "subject",
    "action",
    "reason",
    "scope",
    "conditions",
    "nonce",
    "issued_at",
    "expires_at",
    "revoked_at",
    "supersedes",
    "evidence_refs",
    "digest"
  ],
  "title": "human_decision",
  "type": "object",
  "x-ranex-canonical-producer": "policy",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/HUMAN_DECISION.yaml"
}

  "title": "ranex-delegated-provider v1 protocol and vectors",
  "vectorSemantics": {
    "chat": {
      "field": "expected",
      "meaning": "broker state observation; never an SSE body"
    },
    "handshakeAndVersion": {
      "field": "response",
      "meaning": "literal wire body"
    },
    "independence": "each vector is evaluated from its declared state; replay vectors reuse only their declared key",
    "ordering": "explicit",
    "syntaxVector": "zero-byte deterministic encodings pin syntax only; runtime randomness is implementation-tested"
  },
  "vectors": [

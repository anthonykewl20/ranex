{
  "$id": "https://schemas.ranex.dev/events/governed_execution/activity-dispatched-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activity_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
      "type": "string",
      "x-ranex-id-type": "Activity",
      "x-ranex-registered-opaque-id": true
    },
    "assignment_ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
          "type": "string",
          "x-ranex-id-type": "AgentAssignment",
          "x-ranex-registered-opaque-id": true
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object",
      "x-ranex-ref-type": "AgentAssignment"
    },
    "dispatch_attempt": {
      "minimum": 0,
      "type": "integer"
    },
    "lease_ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
          "type": "string",
          "x-ranex-id-type": "WorkerLease",
          "x-ranex-registered-opaque-id": true
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object",
      "x-ranex-ref-type": "WorkerLease"
    },
    "run_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
      "type": "string",
      "x-ranex-id-type": "Run",
      "x-ranex-registered-opaque-id": true
    },
    "state_edge_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "axis_id": {
            "enum": [
              "WorkItemStatus",
              "RunStatus",
              "AssignmentStatus",
              "DispatchOfferStatus",
              "LeaseStatus",
              "MailboxDeliveryStatus",
              "ReservationStatus",
              "IntakeStatus",
              "PacketStatus",
              "FleetExperimentStatus",
              "CapabilityAssessmentStatus",
              "ActivityStatus",
              "PermitStatus",
              "HumanDecisionRecordStatus",
              "AuthorityGrantStatus",
              "EffectStatus",
              "ReconciliationStatus",
              "IncidentStatus",
              "ReleaseStatus",
              "CapabilityStatus",
              "ModuleStatus",
              "RouteStatus",
              "ExtensionStatus",
              "CompatibilityStatus",
              "InstructionStatus",
              "ArtifactStatus",
              "MigrationStatus",
              "SyncCandidateStatus",
              "UpdateStatus",
              "CutoverStatus"
            ],
            "type": "string"
          },
          "axis_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "edge_id": {
            "pattern": "^[A-Z][A-Za-z0-9]*:[0-9]+\\.[0-9]+\\.[0-9]+:[A-Z][A-Z0-9_]*>[A-Z][A-Z0-9_]*@[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "state_catalog_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "transition_fact_ref": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "id": {
                "maxLength": 255,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
                "type": "string",
                "x-ranex-id-type": "TransitionEvent",
                "x-ranex-registered-opaque-id": true
              }
            },
            "required": [
              "id",
              "digest"
            ],
            "type": "object",
            "x-ranex-ref-type": "TransitionEvent"
          }
        },
        "required": [
          "axis_id",
          "axis_version",
          "state_catalog_digest",
          "edge_id",
          "transition_fact_ref"
        ],
        "type": "object",
        "x-ranex-nested-type": "StateEdgeBindingRefV1"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
      "x-ranex-bytewise-sorted": true
    },
    "worker_attempt_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
      "type": "string",
      "x-ranex-id-type": "WorkerAttempt",
      "x-ranex-registered-opaque-id": true
    }
  },
  "required": [
    "run_id",
    "activity_id",
    "assignment_ref",
    "worker_attempt_id",
    "lease_ref",
    "dispatch_attempt",
    "state_edge_bindings"
  ],
  "title": "ActivityDispatched event payload v1",
  "type": "object",
  "x-ranex-event-id": "EVENT-ACTIVITYDISPATCHED",
  "x-ranex-event-name": "ActivityDispatched",
  "x-ranex-event-version": 1,
  "x-ranex-payload-schema-ref": "ranex:event-payload:ActivityDispatched:v1",
  "x-ranex-source": "docs/architecture/HERMES_GROUND_ZERO_FULL_SYSTEM_ARCHITECTURE.md#172-exact-initial-event-payload-catalog",
  "x-ranex-state-binding": {
    "binding_kind": "EDGE_EVENT",
    "edge_bindings": [
      {
        "allowed_edges": [
          "REQUESTED>DISPATCHED@AUTHORIZATION_ASSIGNMENT_LEASE_AND_BUDGET_CURRENT",
          "FAILED_RETRYABLE>DISPATCHED@RETRY_POLICY_BUDGET_AND_DEADLINE_ALLOW"
        ],
        "axis_id": "ActivityStatus",
        "axis_version": "1.0.0",
        "binding_cardinality": "EXACTLY_ONE"
      }
    ],
    "event_name": "ActivityDispatched"
  },
  "x-ranex-state-binding-digest": "sha256:dc89b65082ab34ae61515639b0cb9bcc8d4e2dac607a0d926e2db13f3aeaf375"
}

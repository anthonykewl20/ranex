  "title": "PolicyChangeBlockedRun event payload v1",
  "type": "object",
  "x-ranex-event-id": "EVENT-POLICYCHANGEBLOCKEDRUN",
  "x-ranex-event-name": "PolicyChangeBlockedRun",
  "x-ranex-event-version": 1,
  "x-ranex-payload-schema-ref": "ranex:event-payload:PolicyChangeBlockedRun:v1",
  "x-ranex-source": "docs/architecture/HERMES_GROUND_ZERO_FULL_SYSTEM_ARCHITECTURE.md#17.2",
  "x-ranex-state-binding": {
    "binding_kind": "REFERENCE_ONLY",
    "event_name": "PolicyChangeBlockedRun",
    "referenced_axis_ids": [
      "RunStatus"
    ]
  },
  "x-ranex-state-binding-digest": "sha256:1f9d870bcd82ccfeb3c167603b30814ba42d6cee9ec3d276ed6448b53d5fb9b0"
}

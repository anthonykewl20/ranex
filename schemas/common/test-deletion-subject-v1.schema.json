{
  "$id": "https://schemas.ranex.dev/common/test-deletion-subject-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_scope_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
      "type": "string"
    },
    "after_commit_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "after_test_row": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "git_blob_oid_sha1": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "marker_count": {
              "const": 1
            },
            "mode": {
              "enum": [
                "100644",
                "100755"
              ],
              "type": "string"
            },
            "path": {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+$",
              "type": "string",
              "x-ranex-normalized-repository-relative-posix-path": true
            },
            "stable_test_id": {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "mode",
            "git_blob_oid_sha1",
            "content_sha256",
            "stable_test_id",
            "marker_count"
          ],
          "type": "object",
          "x-ranex-semantic-invariants": [
            "path is a canonical test .py path under one ADR-0008 test root",
            "Git blob bytes recompute both digests and contain exactly one line '# ranex-test-id: <stable_test_id>'"
          ],
          "x-ranex-type-id": "TestRowV1",
          "x-ranex-type-version": "1.0.0"
        },
        {
          "type": "null"
        }
      ]
    },
    "after_tests_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "after_tests_tree_oid_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "before_commit_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "before_test_row": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "git_blob_oid_sha1": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "marker_count": {
              "const": 1
            },
            "mode": {
              "enum": [
                "100644",
                "100755"
              ],
              "type": "string"
            },
            "path": {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+$",
              "type": "string",
              "x-ranex-normalized-repository-relative-posix-path": true
            },
            "stable_test_id": {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "mode",
            "git_blob_oid_sha1",
            "content_sha256",
            "stable_test_id",
            "marker_count"
          ],
          "type": "object",
          "x-ranex-semantic-invariants": [
            "path is a canonical test .py path under one ADR-0008 test root",
            "Git blob bytes recompute both digests and contain exactly one line '# ranex-test-id: <stable_test_id>'"
          ],
          "x-ranex-type-id": "TestRowV1",
          "x-ranex-type-version": "1.0.0"
        },
        {
          "type": "null"
        }
      ]
    },
    "before_tests_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "before_tests_tree_oid_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "closes_change_exception_id": {
      "oneOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "deletion_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
      "type": "string"
    },
    "legacy_baseline_source_row": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "git_blob_oid_sha1": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "mode": {
              "enum": [
                "100644",
                "100755"
              ],
              "type": "string"
            },
            "path": {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+$",
              "type": "string",
              "x-ranex-normalized-repository-relative-posix-path": true
            }
          },
          "required": [
            "path",
            "mode",
            "git_blob_oid_sha1",
            "content_sha256"
          ],
          "type": "object",
          "x-ranex-semantic-invariants": [
            "row equals the immutable ADR-0010 baseline source row and Git blob bytes"
          ],
          "x-ranex-type-id": "LegacyBaselineSourceRowV1",
          "x-ranex-type-version": "1.0.0"
        },
        {
          "type": "null"
        }
      ]
    },
    "legacy_current_source_row": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "mode": {
              "enum": [
                "100644",
                "100755"
              ],
              "type": "string"
            },
            "path": {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+$",
              "type": "string",
              "x-ranex-normalized-repository-relative-posix-path": true
            }
          },
          "required": [
            "path",
            "mode",
            "content_sha256"
          ],
          "type": "object",
          "x-ranex-semantic-invariants": [
            "row equals the authorized ADR-0010 event-time current source row and before-commit Git bytes"
          ],
          "x-ranex-type-id": "LegacyCurrentSourceRowV1",
          "x-ranex-type-version": "1.0.0"
        },
        {
          "type": "null"
        }
      ]
    },
    "legacy_source_state_kind": {
      "oneOf": [
        {
          "enum": [
            "IMMUTABLE_BASELINE",
            "AUTHORIZED_CHANGE_EXCEPTION"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
      "type": "string"
    },
    "policy_id": {
      "const": "RANEX-TEST-DELETION-1.0"
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "profile_freshness_status": {
      "enum": [
        "CURRENT",
        "STALE",
        "NOT_ASSESSED"
      ],
      "type": "string"
    },
    "reason": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "source_change_exception_id": {
      "oneOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_migration_proof_ids": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true,
      "x-ranex-bytewise-sorted": true
    },
    "stable_test_id": {
      "oneOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_ref": {
      "pattern": "^urn:ranex:[^\\s]+$",
      "type": "string"
    },
    "subject_schema": {
      "const": "test-deletion-subject/v1"
    },
    "target_kind": {
      "enum": [
        "LEGACY_SOURCE",
        "CANONICAL_TEST"
      ],
      "type": "string"
    },
    "tdd_rule_set_id": {
      "const": "RANEX-TDD-1.0"
    },
    "test_practice_profile_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "test_practice_profile_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
      "type": "string"
    },
    "test_practice_profile_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "tests_delta_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "subject_schema",
    "subject_ref",
    "deletion_id",
    "target_kind",
    "policy_id",
    "policy_version",
    "tdd_rule_set_id",
    "test_practice_profile_id",

      "additionalProperties": false,
      "properties": {
        "any_other_non_descendant": {
          "const": "UNKNOWN_BLOCKING"
        },
        "exact_noninherited_descendant": {
          "const": "NOT_APPLICABLE_NO_INHERITED_SUBJECT"

    "inherited_baseline": {
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "const": "HERMES-TEST-BASELINE-001"
        },
        "file_count": {
          "const": 2444
        },
        "file_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_commit_sha1": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "source_commit_sha1",
        "baseline_id",
        "file_count",
        "file_manifest_sha256"
      ],
      "type": "object"

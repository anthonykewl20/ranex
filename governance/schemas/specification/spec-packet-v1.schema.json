{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ranex.dev/schemas/specification/spec-packet-v1.schema.json",
  "title": "SpecPacketV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "domain", "task", "revision", "semantics", "scope", "answers", "observable_outcomes", "non_goals", "oracle_provenance", "ids"],
  "properties": {
    "version": {"const": "spec-packet-v1"},
    "domain": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "semantics": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["include", "exclude"], "properties": {"include": {"type": "array", "items": {"type": "string"}}, "exclude": {"type": "array", "items": {"type": "string"}}}},
    "answers": {"type": "object", "additionalProperties": {"type": "string"}},
    "observable_outcomes": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "oracle_provenance": {"type": "object", "additionalProperties": {"enum": ["human", "domain-rule", "requirement", "observed-only"]}},
    "ids": {"type": "object", "additionalProperties": false, "required": ["question", "rule", "transition", "outcome", "error", "test", "mapping"], "properties": {"question": {"$ref": "#/$defs/idList"}, "rule": {"$ref": "#/$defs/idList"}, "transition": {"$ref": "#/$defs/idList"}, "outcome": {"$ref": "#/$defs/idList"}, "error": {"$ref": "#/$defs/idList"}, "test": {"$ref": "#/$defs/idList"}, "mapping": {"$ref": "#/$defs/idList"}}}
  },
  "$defs": {"idList": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}}
}

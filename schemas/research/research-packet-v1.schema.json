{
  "$id": "https://schemas.ranex.dev/research/research-packet-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "research_packet"
    },
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "epistemic_status": {
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "limitations": {
            "items": {},
            "type": "array",
            "x-ranex-element-type": "UNDECIDED"
          },
          "statement": {
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "statement",
          "epistemic_status",
          "evidence_refs",
          "confidence",
          "limitations"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "contradictions": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file_mutations": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "full_map_impact": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "method": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "negative_results": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "question": {
      "type": "string"
    },
    "recommendations": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "research_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "scope": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "source_manifest": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authority": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
          },
          "freshness": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "x-ranex-runtime-format": "date-time"
          },
          "path_or_uri": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          }
        },
        "required": [
          "path_or_uri",
          "revision",
          "digest",
          "source_type",
          "authority",
          "observed_at",
          "freshness"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "type": "string"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "base_revision": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "x-ranex-runtime-format": "date-time"
        },
        "project_id": {
          "type": "string"
        },
        "question_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repository_id": {
          "type": "string"
        },
        "repository_uri_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "research_prompt_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scope_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_manifest_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_schema": {
          "type": "string"
        },
        "work_item_id": {
          "type": "string"
        }
      },
      "required": [
        "subject_schema",
        "project_id",
        "work_item_id",
        "repository_id",
        "repository_uri_digest",
        "base_revision",
        "question_digest",
        "scope_digest",
        "source_manifest_digest",
        "research_prompt_digest",
        "observed_at"
      ],
      "type": "object"
    },
    "unknowns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance_test": {
            "type": "string"
          },
          "closure_evidence": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "risk_if_guessed": {
            "type": "string"
          },
          "unknown": {
            "type": "string"
          }
        },
        "required": [
          "unknown",
          "priority",
          "risk_if_guessed",
          "closure_evidence",
          "acceptance_test"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "research_id",
    "status",
    "core_sdlc_trace_ref",
    "subject",
    "question",
    "scope",
    "method",
    "source_manifest",
    "claims",
    "contradictions",
    "negative_results",
    "unknowns",
    "recommendations",
    "full_map_impact",
    "file_mutations",
    "digest"
  ],
  "title": "research_packet",
  "type": "object",
  "x-ranex-canonical-producer": "product_definition",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/RESEARCH_PACKET.yaml"
}

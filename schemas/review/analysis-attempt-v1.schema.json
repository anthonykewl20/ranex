{
  "$id": "https://schemas.ranex.dev/review/analysis-attempt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "absolute_deadline": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "artifact_type": {
      "const": "analysis_attempt"
    },
    "attempt_id": {
      "type": "string"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "failure_domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "granted_capabilities": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "input_artifact_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "input_manifest_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "previous_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_output_artifact_ref": {
      "type": "string"
    },
    "raw_output_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "retry_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_request_id": {
      "type": "string"
    },
    "reviewer": {
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "type": "string"
        },
        "role_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "role_id",
        "session_id"
      ],
      "type": "object"
    },
    "route": {
      "additionalProperties": false,
      "properties": {
        "actual_model_id": {
          "type": "string"
        },
        "actual_model_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual_provider_id": {
          "type": "string"
        },
        "executable_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "isolation_profile_id": {
          "type": "string"
        },
        "parser_version": {
          "type": "string"
        },
        "route_lock_id": {
          "type": "string"
        },
        "transport_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "transport_id": {
          "type": "string"
        }
      },
      "required": [
        "route_lock_id",
        "actual_provider_id",
        "actual_model_id",
        "actual_model_snapshot",
        "transport_id",
        "transport_digest",
        "executable_digest",
        "parser_version",
        "isolation_profile_id"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1"
    },
    "started_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "write_attempt_evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "attempt_id",
    "review_request_id",
    "previous_attempt_id",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "reviewer",
    "route",
    "input_artifact_refs",
    "input_manifest_digest",
    "granted_capabilities",
    "write_attempt_evidence_refs",
    "started_at",
    "finished_at",
    "absolute_deadline",
    "status",
    "failure_domain",
    "retry_class",
    "usage",
    "raw_output_artifact_ref",
    "raw_output_digest",
    "digest"
  ],
  "title": "analysis_attempt",
  "type": "object",
  "x-ranex-canonical-producer": "analytical_review",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/ANALYSIS_ATTEMPT.yaml"
}

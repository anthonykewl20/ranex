              },
              "generation_id": {
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",
                "type": "string"
              },
              "generation_number": {
                "minimum": 1,
                "type": "integer"
              },
              "history_id": {
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,254}$",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ranex.dev/schemas/specification/approval-envelope-v1.schema.json",
  "title": "ApprovalEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "payload_type", "payload", "key_id", "signature"],
  "properties": {
    "version": {"const": "approval-envelope-v1"},
    "payload_type": {"const": "application/vnd.ranex.approval-envelope.v1+json"},
    "payload": {"$ref": "#/$defs/payload"},
    "key_id": {"$ref": "#/$defs/publicKey"},
    "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9+/]{85}[AQgw]==$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "publicKey": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "domain", "task", "revision", "subject_digest", "base_digest", "a_digest", "b_digest", "principal", "key", "role", "nonce", "journal_predecessor", "time_window", "capability_request", "profile_digests"],
      "properties": {
        "version": {"const": "approval-payload-v1"}, "domain": {"type": "string", "minLength": 1}, "task": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 0},
        "subject_digest": {"$ref": "#/$defs/digest"}, "base_digest": {"$ref": "#/$defs/digest"}, "a_digest": {"$ref": "#/$defs/digest"}, "b_digest": {"$ref": "#/$defs/digest"},
        "principal": {"type": "string", "minLength": 1}, "key": {"$ref": "#/$defs/publicKey"}, "role": {"type": "string", "minLength": 1}, "nonce": {"type": "string", "minLength": 1},
        "journal_predecessor": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "time_window": {"type": "object", "additionalProperties": false, "description": "Both bounds are non-negative journal sequence integers; not_before must be less than or equal to not_after. Draft 2020-12 has no portable cross-property comparison keyword, so vectors pin the ordering rule.", "required": ["not_before", "not_after"], "properties": {"not_before": {"type": "integer", "minimum": 0}, "not_after": {"type": "integer", "minimum": 0}}},
        "capability_request": {"type": "object", "additionalProperties": false, "required": ["executable", "argv", "cwd", "roots", "actions", "environment", "network", "secret", "commit", "subagent"], "properties": {"executable": {"type": "string", "minLength": 1}, "argv": {"type": "array", "items": {"type": "string"}}, "cwd": {"type": "string", "minLength": 1}, "roots": {"type": "array", "items": {"type": "string"}}, "actions": {"type": "array", "items": {"type": "string"}}, "environment": {"type": "object", "additionalProperties": false, "required": ["allow"], "properties": {"allow": {"type": "array", "items": {"type": "string"}}}}, "network": {"type": "object", "additionalProperties": false, "required": ["allow", "hosts"], "properties": {"allow": {"type": "boolean"}, "hosts": {"type": "array", "items": {"type": "string"}}}}, "secret": {"type": "object", "additionalProperties": false, "required": ["allow", "names"], "properties": {"allow": {"type": "boolean"}, "names": {"type": "array", "items": {"type": "string"}}}}, "commit": {"type": "object", "additionalProperties": false, "required": ["allow"], "properties": {"allow": {"type": "boolean"}}}, "subagent": {"type": "object", "additionalProperties": false, "required": ["allow", "max_children"], "properties": {"allow": {"type": "boolean"}, "max_children": {"type": "integer", "minimum": 0}}}}},
        "profile_digests": {"type": "object", "additionalProperties": false, "required": ["base", "policy", "generator", "harness"], "properties": {"base": {"$ref": "#/$defs/digest"}, "policy": {"$ref": "#/$defs/digest"}, "generator": {"$ref": "#/$defs/digest"}, "harness": {"$ref": "#/$defs/digest"}}}
      }
    }
  }
}

{
  "$id": "https://schemas.ranex.dev/assurance/evidence-snapshot-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "evidence_snapshot"
    },
    "conflicts": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "coverage": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "created_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "created_by_service_id": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eligible_evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "freshness_cutoff": {
      "type": "string"
    },
    "ineligible_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_ref": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          }
        },
        "required": [
          "evidence_ref",
          "reason_code"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "missing_claim_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "policy_activation_id": {
      "type": "string"
    },
    "policy_activation_manifest_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "required_claim_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1"
    },
    "snapshot_id": {
      "type": "string"
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "snapshot_id",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "policy_activation_id",
    "policy_activation_manifest_digest",
    "required_claim_ids",
    "eligible_evidence_refs",
    "ineligible_evidence",
    "freshness_cutoff",
    "coverage",
    "missing_claim_ids",
    "conflicts",
    "created_by_service_id",
    "created_at",
    "digest"
  ],
  "title": "evidence_snapshot",
  "type": "object",
  "x-ranex-canonical-producer": "assurance",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/EVIDENCE_SNAPSHOT.yaml"
}

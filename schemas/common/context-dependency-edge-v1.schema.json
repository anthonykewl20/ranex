{
  "$id": "https://schemas.ranex.dev/common/context-dependency-edge-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "callee": {
      "minLength": 1,
      "type": "string"
    },
    "callee_owner": {
      "minLength": 1,
      "type": "string"
    },
    "caller": {
      "minLength": 1,
      "type": "string"
    },
    "caller_owner": {
      "minLength": 1,
      "type": "string"
    },
    "consistency": {
      "enum": [
        "READ_ONLY_SNAPSHOT",
        "CALLEE_TRANSACTION_ONLY",
        "EVENTUAL_OUTBOX"
      ]
    },
    "definition_status": {
      "const": "DEFINED"
    },
    "edge_id": {
      "minLength": 1,
      "type": "string"
    },
    "failure": {
      "const": "FAIL_CLOSED_REQUIRED"
    },
    "interaction": {
      "enum": [
        "SYNC_QUERY",
        "SYNC_COMMAND",
        "ASYNC_EVENT"
      ]
    },
    "rationale": {
      "minLength": 1,
      "type": "string"
    },
    "recovery": {
      "enum": [
        "REFRESH_REEVALUATE",
        "IDEMPOTENT_RETRY_RECONCILE",
        "OUTBOX_REPLAY_RECONCILE"
      ]
    },
    "runtime_validation_status": {
      "const": "NOT_ASSESSED"
    },
    "schema_version": {
      "const": "context-dependency-edge/v1"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "edge_id",
    "caller",
    "callee",
    "caller_owner",
    "callee_owner",
    "rationale",
    "interaction",
    "consistency",
    "failure",
    "recovery",
    "definition_status",
    "runtime_validation_status",
    "source"
  ],
  "title": "Ranex declared context dependency edge",
  "type": "object"
}

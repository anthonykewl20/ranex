{
  "$id": "https://schemas.ranex.dev/common/subject-binding-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "subject_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "subject_manifest_digest": {
      "oneOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_ref": {
      "minLength": 1,
      "type": "string"
    },
    "subject_schema": {
      "enum": [
        "work-subject/v1",
        "exact-subject/v1",
        "architecture-subject/v1",
        "research-subject/v1",
        "resource-subject/v1"
      ]
    }
  },
  "required": [
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest"
  ],
  "type": "object"
}

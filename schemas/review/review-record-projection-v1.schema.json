{
  "$id": "https://schemas.ranex.dev/review/review-record-projection-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_attempt_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "artifact_type": {
      "const": "review_record_projection"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gate_evaluation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "independence_evaluation_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "independence_evaluation_id": {
      "type": "string"
    },
    "projection_id": {
      "type": "string"
    },
    "review_observation_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "review_request_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "review_request_id": {
      "type": "string"
    },
    "review_verdict_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "review_verdict_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "source_registry_version": {
      "type": "string"
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "projection_id",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "review_request_id",
    "review_request_digest",
    "analysis_attempt_refs",
    "review_observation_refs",
    "independence_evaluation_id",
    "independence_evaluation_digest",
    "review_verdict_id",
    "review_verdict_digest",
    "gate_evaluation_ref",
    "generated_at",
    "source_registry_version",
    "digest"
  ],
  "title": "review_record_projection",
  "type": "object",
  "x-ranex-canonical-producer": "analytical_review",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/REVIEW_RECORD.yaml"
}

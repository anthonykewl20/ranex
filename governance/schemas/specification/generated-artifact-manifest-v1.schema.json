{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ranex.dev/schemas/specification/generated-artifact-manifest-v1.schema.json",
  "title": "GeneratedArtifactManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "domain", "a_digest", "artifacts", "exemptions"],
  "properties": {
    "version": {"const": "generated-artifact-manifest-v1"}, "domain": {"type": "string", "minLength": 1}, "a_digest": {"$ref": "#/$defs/digest"},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["pseudocode_flow", "protected", "invocation", "expected_values", "baselines", "negative_controls", "trace_projections", "sidecars"], "properties": {"pseudocode_flow": {"$ref": "#/$defs/artifactList"}, "protected": {"$ref": "#/$defs/artifactList"}, "invocation": {"type": "object", "additionalProperties": false, "required": ["argv"], "properties": {"argv": {"type": "array", "items": {"type": "string"}}}}, "expected_values": {"$ref": "#/$defs/artifactList"}, "baselines": {"$ref": "#/$defs/artifactList"}, "negative_controls": {"$ref": "#/$defs/artifactList"}, "trace_projections": {"$ref": "#/$defs/artifactList"}, "sidecars": {"$ref": "#/$defs/artifactList"}}},
    "exemptions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "class", "reason", "why_no_discriminating_red"], "properties": {"path": {"type": "string", "minLength": 1}, "class": {"enum": ["generated", "vendor", "docs", "nonbehavioral"]}, "reason": {"type": "string", "minLength": 1}, "why_no_discriminating_red": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "artifactList": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}}}}
}

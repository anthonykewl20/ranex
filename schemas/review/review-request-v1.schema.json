{
  "$id": "https://schemas.ranex.dev/review/review-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "absolute_deadline": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "artifact_type": {
      "const": "review_request"
    },
    "blind_context_manifest_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "maker": {
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "type": "string"
        },
        "role_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "role_id",
        "run_id",
        "session_id"
      ],
      "type": "object"
    },
    "packet_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "packet_id": {
      "type": "string"
    },
    "prohibited_capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "qualification_policy_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "required_independence": {
      "items": {},
      "type": "array"
    },
    "required_reviewer_role_id": {
      "type": "string"
    },
    "required_route_fact_diversity": {
      "items": {},
      "type": "array"
    },
    "review_spec_id": {
      "type": "string"
    },
    "review_spec_version": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "request_id",
    "review_spec_id",
    "review_spec_version",
    "packet_id",
    "packet_digest",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "maker",
    "required_reviewer_role_id",
    "required_independence",
    "prohibited_capabilities",
    "blind_context_manifest_digest",
    "required_route_fact_diversity",
    "qualification_policy_id",
    "absolute_deadline",
    "digest"
  ],
  "title": "review_request",
  "type": "object",
  "x-ranex-canonical-producer": "analytical_review",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/REVIEW_REQUEST.yaml"
}

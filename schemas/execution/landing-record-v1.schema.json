{
  "$id": "https://schemas.ranex.dev/execution/landing-record-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_principal_id": {
      "type": "string"
    },
    "artifact_type": {
      "const": "landing_record"
    },
    "candidate_commit": {
      "type": "string"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "items": {},
      "type": "array"
    },
    "finished_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "landed_commit": {
      "type": "string"
    },
    "landing_id": {
      "type": "string"
    },
    "landing_strategy": {
      "type": "string"
    },
    "permit_id": {
      "type": "string"
    },
    "provider_receipt_ref": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "started_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": "string"
    },
    "target_branch": {
      "type": "string"
    },
    "target_head_before": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "landing_id",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "candidate_commit",
    "target_branch",
    "target_head_before",
    "landed_commit",
    "landing_strategy",
    "permit_id",
    "actor_principal_id",
    "provider_receipt_ref",
    "started_at",
    "finished_at",
    "status",
    "evidence_refs",
    "digest"
  ],
  "title": "landing_record",
  "type": "object",
  "x-ranex-canonical-producer": "workspace",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/LANDING_RECORD.yaml"
}

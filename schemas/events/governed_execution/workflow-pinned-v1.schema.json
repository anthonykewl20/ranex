{
  "$id": "https://schemas.ranex.dev/events/governed_execution/workflow-pinned-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
      "type": "string",
      "x-ranex-id-type": "Run",
      "x-ranex-registered-opaque-id": true
    },
    "workflow_definition_ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
          "type": "string",
          "x-ranex-id-type": "WorkflowDefinition",
          "x-ranex-registered-opaque-id": true
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object",
      "x-ranex-ref-type": "WorkflowDefinition"
    },
    "workflow_interpreter_version": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "workflow_policy_ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$",
          "type": "string",
          "x-ranex-id-type": "PolicyActivation",
          "x-ranex-registered-opaque-id": true
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object",
      "x-ranex-ref-type": "PolicyActivation"
    }
  },
  "required": [
    "run_id",
    "workflow_definition_ref",
    "workflow_interpreter_version",
    "workflow_policy_ref"
  ],
  "title": "WorkflowPinned event payload v1",
  "type": "object",
  "x-ranex-event-id": "EVENT-WORKFLOWPINNED",
  "x-ranex-event-name": "WorkflowPinned",
  "x-ranex-event-version": 1,
  "x-ranex-payload-schema-ref": "ranex:event-payload:WorkflowPinned:v1",
  "x-ranex-source": "docs/architecture/HERMES_GROUND_ZERO_FULL_SYSTEM_ARCHITECTURE.md#17.2",
  "x-ranex-state-binding": {
    "binding_kind": "REFERENCE_ONLY",
    "event_name": "WorkflowPinned",
    "referenced_axis_ids": []
  },
  "x-ranex-state-binding-digest": "sha256:960fb1b4c7bf2bca0008c5b8785d303aab17446a1ff718a421e5d3f7c185ed10"
}

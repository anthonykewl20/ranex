[
  {
    "case": "signed-http",
    "status": "VERIFIED",
    "expected": "signed ping returns 200",
    "observed": {
      "status": 200,
      "body": "accepted"
    }
  },
  {
    "case": "unsigned-http",
    "status": "VERIFIED",
    "expected": "unsigned body returns 401",
    "observed": {
      "status": 401,
      "body": "delivery did not prove itself"
    }
  },
  {
    "case": "dedupe-in-process",
    "status": "VERIFIED",
    "expected": "same delivery is a no-op",
    "observed": {
      "delivery": "ping-1",
      "outcome": "replayed"
    }
  },
  {
    "case": "retry-after-real-fetch-failure",
    "status": "GAP",
    "expected": "unchanged unavailable Git remote remains retryable on redelivery",
    "observed": [
      {
        "status": 500,
        "body": "retry later"
      },
      {
        "status": 200,
        "body": "accepted"
      }
    ]
  },
  {
    "case": "malformed-json",
    "status": "GAP",
    "expected": "authenticated malformed event is a journaled, named permanent refusal",
    "observed": {
      "error": "RemoteDisconnected",
      "detail": "Remote end closed connection without response"
    }
  },
  {
    "case": "malformed-number",
    "status": "GAP",
    "expected": "authenticated malformed event is a journaled, named permanent refusal",
    "observed": {
      "error": "RemoteDisconnected",
      "detail": "Remote end closed connection without response"
    }
  },
  {
    "case": "dedupe-after-restart",
    "status": "GAP",
    "expected": "delivery spool survives process restart",
    "observed": {
      "response": {
        "status": 200,
        "body": "accepted"
      },
      "entry": {
        "delivery": "ping-1",
        "event": "ping",
        "outcome": "ignored"
      }
    }
  },
  {
    "case": "negative-content-length",
    "status": "GAP",
    "expected": "one unproven client does not monopolize the single listener",
    "observed": {
      "concurrent_healthy": {
        "error": "TimeoutError",
        "detail": "timed out"
      },
      "after_release": {
        "status": 200,
        "body": "accepted"
      },
      "raw_request": "POST /webhook HTTP/1.1\r\nHost: localhost\r\nContent-Length: -1\r\n\r\n"
    }
  },
  {
    "case": "incomplete-body",
    "status": "GAP",
    "expected": "one unproven client does not monopolize the single listener",
    "observed": {
      "concurrent_healthy": {
        "error": "TimeoutError",
        "detail": "timed out"
      },
      "after_release": {
        "status": 200,
        "body": "accepted"
      },
      "raw_request": "POST /webhook HTTP/1.1\r\nHost: localhost\r\nContent-Length: 20\r\n\r\n{"
    }
  },
  {
    "case": "idle-client",
    "status": "GAP",
    "expected": "one unproven client does not monopolize the single listener",
    "observed": {
      "concurrent_healthy": {
        "error": "TimeoutError",
        "detail": "timed out"
      },
      "after_release": {
        "status": 200,
        "body": "accepted"
      },
      "raw_request": ""
    }
  }
]

{
  "$id": "https://schemas.ranex.dev/review/review-observation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_attempt_id": {
      "type": "string"
    },
    "artifact_type": {
      "const": "review_observation"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "epistemic_status": {
                  "const": "FACT"
                }
              },
              "required": [
                "epistemic_status"
              ]
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "severity": {
                  "const": "error"
                }
              },
              "required": [
                "severity"
              ]
            },
            "then": {
              "properties": {
                "epistemic_status": {
                  "const": "FACT"
                }
              },
              "required": [
                "epistemic_status"
              ]
            }
          }
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "epistemic_status": {
            "enum": [
              "FACT",
              "INFERENCE",
              "OWNER_REQUIREMENT",
              "PROPOSAL",
              "REPORTED_ADVISORY_RESULT"
            ]
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "finding_id": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "owner_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "reconciliation_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_action": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "none",
              "note",
              "warning",
              "error"
            ]
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "category",
          "severity",
          "confidence",
          "epistemic_status",
          "location",
          "claim",
          "impact",
          "evidence_refs",
          "required_action",
          "owner_ref",
          "state",
          "reconciliation_ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "limitations": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "observation_id": {
      "type": "string"
    },
    "proposed_actions": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "review_request_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "state": {
      "type": "string"
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "uncertainties": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "observation_id",
    "review_request_id",
    "analysis_attempt_id",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "state",
    "summary",
    "findings",
    "uncertainties",
    "limitations",
    "proposed_actions",
    "digest"
  ],
  "title": "review_observation",
  "type": "object",
  "x-ranex-canonical-producer": "analytical_review",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/REVIEW_OBSERVATION.yaml"
}

{
  "$id": "https://schemas.ranex.dev/common/resource-subject-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "effect_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_subject_digest": {
      "oneOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_subject_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository_id": {
      "minLength": 1,
      "type": "string"
    },
    "repository_uri_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope_kind": {
      "enum": [
        "PROJECT",
        "RELEASE",
        "WORK_ITEM",
        "RUN",
        "WORKER_ATTEMPT",
        "ACTIVITY",
        "EFFECT"
      ]
    },
    "scope_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "subject_schema": {
      "const": "resource-subject/v1"
    },
    "work_item_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "worker_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "subject_schema",
    "scope_kind",
    "project_id",
    "release_id",
    "work_item_id",
    "run_id",
    "worker_attempt_id",
    "activity_id",
    "effect_id",
    "parent_subject_ref",
    "repository_id",
    "repository_uri_digest",
    "base_revision",
    "scope_manifest_digest",
    "parent_subject_digest"
  ],
  "title": "resource-subject-v1",
  "type": "object"
}

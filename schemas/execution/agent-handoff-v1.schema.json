{
  "$id": "https://schemas.ranex.dev/execution/agent-handoff-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "artifact_type": {
      "const": "agent_handoff"
    },
    "consumer_role_id": {
      "type": "string"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "finding_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "handoff_id": {
      "type": "string"
    },
    "limitations": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "role_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "transport_id": {
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "role_id",
        "provider_id",
        "model_id",
        "transport_id",
        "session_id"
      ],
      "type": "object"
    },
    "requested_next_action": {
      "type": "string"
    },
    "run_result_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_result_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "handoff_id",
    "producer",
    "consumer_role_id",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "run_result_id",
    "run_result_digest",
    "evidence_refs",
    "finding_refs",
    "artifact_refs",
    "limitations",
    "requested_next_action",
    "digest"
  ],
  "title": "agent_handoff",
  "type": "object",
  "x-ranex-canonical-producer": "agent_collaboration",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/AI_HANDOFF.yaml"
}

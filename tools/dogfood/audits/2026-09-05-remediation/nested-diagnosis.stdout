        stderr_fd = os.open(stderr_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    
        pid = os.fork()
        if pid == 0:
            os.dup2(stdout_fd, 1)
            os.dup2(stderr_fd, 2)
            os.close(stdout_fd)
            os.close(stderr_fd)
            os.chdir(root)
            if _ptrace(PTRACE_TRACEME, 0) != 0:
                os._exit(125)

    "history_anchor_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z][A-Za-z0-9._:-]{0,254}|urn:[^\\s]{1,1020})$",
      "type": "string"
    },
    "method_rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",

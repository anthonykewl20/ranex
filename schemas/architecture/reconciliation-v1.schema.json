{
  "$id": "https://schemas.ranex.dev/architecture/reconciliation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architecture_review_packet_id": {
      "type": "string"
    },
    "artifact_type": {
      "const": "architecture_reconciliation"
    },
    "challenge_observation_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "disposition": {
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "finding_id": {
            "type": "string"
          },
          "human_decision_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "resulting_change_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "finding_id",
          "disposition",
          "rationale",
          "evidence_refs",
          "resulting_change_refs",
          "human_decision_ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "proposal_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reconciliation_id": {
      "type": "string"
    },
    "resulting_adr_ref": {
      "type": "string"
    },
    "resulting_architecture_document_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resulting_core_sdlc_trace_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "resulting_subject": {
      "additionalProperties": false,
      "properties": {
        "subject_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_manifest_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_ref": {
          "type": "string"
        },
        "subject_schema": {
          "type": "string"
        }
      },
      "required": [
        "subject_schema",
        "subject_ref",
        "subject_digest",
        "subject_manifest_digest"
      ],
      "type": "object"
    },
    "reviewed_core_sdlc_trace_ref": {
      "type": "string"
    },
    "reviewed_subject": {
      "additionalProperties": false,
      "properties": {
        "subject_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_manifest_digest": {
          "type": "string",
          "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_ref": {
          "type": "string"
        },
        "subject_schema": {
          "type": "string"
        }
      },
      "required": [
        "subject_schema",
        "subject_ref",
        "subject_digest",
        "subject_manifest_digest"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1"
    },
    "unresolved_conflicts": {
      "items": {},
      "type": "array",
      "x-ranex-element-type": "UNDECIDED"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "reconciliation_id",
    "architecture_review_packet_id",
    "proposal_ids",
    "challenge_observation_ids",
    "reviewed_core_sdlc_trace_ref",
    "reviewed_subject",
    "findings",
    "unresolved_conflicts",
    "resulting_architecture_document_digest",
    "resulting_subject",
    "resulting_core_sdlc_trace_ref",
    "resulting_adr_ref",
    "digest"
  ],
  "title": "architecture_reconciliation",
  "type": "object",
  "x-ranex-canonical-producer": "analytical_review",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/ARCHITECTURE_RECONCILIATION.yaml"
}

{
  "$id": "https://schemas.ranex.dev/lifecycle/outcome-review-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "outcome_review"
    },
    "baseline_measure_refs": {
      "items": {},
      "type": "array"
    },
    "capability_id": {
      "type": "string"
    },
    "core_sdlc_trace_ref": {
      "type": "string"
    },
    "data_quality_evidence_refs": {
      "items": {},
      "type": "array"
    },
    "decision": {
      "type": [
        "string",
        "null"
      ]
    },
    "digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "follow_up_work_item_ids": {
      "items": {},
      "type": "array"
    },
    "hypothesis_ref": {
      "type": "string"
    },
    "limitations": {
      "items": {},
      "type": "array"
    },
    "observed_measure_refs": {
      "items": {},
      "type": "array"
    },
    "outcome_review_id": {
      "type": "string"
    },
    "product_owner_decision_ref": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "x-ranex-runtime-format": "date-time"
    },
    "schema_version": {
      "const": "1"
    },
    "segments": {
      "items": {},
      "type": "array"
    },
    "side_effects": {
      "items": {},
      "type": "array"
    },
    "subject_digest": {
      "type": "string",
      "x-ranex-runtime-pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_manifest_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "subject_schema": {
      "type": "string"
    },
    "work_item_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "outcome_review_id",
    "subject_schema",
    "subject_ref",
    "subject_digest",
    "subject_manifest_digest",
    "core_sdlc_trace_ref",
    "work_item_id",
    "capability_id",
    "release_id",
    "hypothesis_ref",
    "baseline_measure_refs",
    "observed_measure_refs",
    "data_quality_evidence_refs",
    "side_effects",
    "segments",
    "decision",
    "product_owner_decision_ref",
    "follow_up_work_item_ids",
    "limitations",
    "reviewed_at",
    "digest"
  ],
  "title": "outcome_review",
  "type": "object",
  "x-ranex-canonical-producer": "product_definition",
  "x-ranex-runtime-semantics": "scripts/architecture/validate_contracts.py",
  "x-ranex-template": "docs/architecture/templates/OUTCOME_REVIEW.yaml"
}

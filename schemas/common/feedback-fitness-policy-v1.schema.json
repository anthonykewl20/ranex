{
  "$id": "https://schemas.ranex.dev/common/feedback-fitness-policy-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_manifest_owner": {
      "minLength": 1,
      "type": "string"
    },
    "decision_binding": {
      "type": "object"
    },
    "escalation": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "feedback_policy_id": {
      "minLength": 1,
      "type": "string"
    },
    "fitness_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "measurement_owner": {
      "minLength": 1,
      "type": "string"
    },
    "noncompensating": {
      "const": true
    },
    "objectives": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cadence": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "lane": {
            "enum": [
              "FAST_LOOP",
              "PRE_VERIFICATION"
            ]
          },
          "measure": {
            "minLength": 1,
            "type": "string"
          },
          "objective_id": {
            "minLength": 1,
            "type": "string"
          },
          "owner_id": {
            "minLength": 1,
            "type": "string"
          },
          "rationale": {
            "minLength": 1,
            "type": "string"
          },
          "result": {
            "const": "NOT_ASSESSED"
          },
          "statistic": {
            "enum": [
              "p50",
              "p95"
            ]
          },
          "target": {
            "minLength": 1,
            "type": "string"
          },
          "window": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "objective_id",
          "lane",
          "measure",
          "statistic",
          "target",
          "window",
          "cadence",
          "rationale",
          "owner_id",
          "result",
          "evidence_refs"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "reference_host_profile_status": {
      "const": "NOT_ASSESSED"
    },
    "remediation_owner": {
      "minLength": 1,
      "type": "string"
    },
    "rule_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "runtime_validation_status": {
      "const": "NOT_ASSESSED"
    },
    "schema_version": {
      "const": "feedback-fitness-policy/v1"
    },
    "selection": {
      "additionalProperties": false,
      "properties": {
        "manifest_required": {
          "const": true
        },
        "omission_status": {
          "const": "UNKNOWN_BLOCKING"
        },
        "rule": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "manifest_required",
        "rule",
        "omission_status"
      ],
      "type": "object"
    },
    "sharding": {
      "additionalProperties": false,
      "properties": {
        "determinism_required": {
          "const": true
        },
        "recorded_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "rule": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "rule",
        "recorded_fields",
        "determinism_required"
      ],
      "type": "object"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "feedback_policy_id",
    "version",
    "measurement_owner",
    "candidate_manifest_owner",
    "remediation_owner",
    "reference_host_profile_status",
    "objectives",
    "selection",
    "sharding",
    "escalation",
    "rule_ids",
    "fitness_ids",
    "noncompensating",
    "decision_binding",
    "runtime_validation_status",
    "source"
  ],
  "title": "Ranex TDD feedback-fitness policy",
  "type": "object"
}
